title: $:/plugins/rimir/drop-attach/styles-target
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

\whitespace trim
\rules except dash
<!-- Marks the selected paste target: a thin bar on its left edge, drawn as a
     background image so it needs no pseudo-element or positioning on the
     target. One selector per target spec: <selector>[<title-attribute>="<title>"] -->
<$let t={{$:/temp/rimir/drop-attach/target}} et={{{ [{$:/temp/rimir/drop-attach/target}escapecss[]] }}} open="[" close="]" q='"'>
<%if [<t>!is[blank]] %>
<$text text={{{ [all[shadows+tiddlers]tag[$:/tags/rimir/drop-attach/target]!is[draft]] :map[<currentTiddler>get[selector]addsuffix<open>addsuffix{!!title-attribute}addsuffix[=]addsuffix<q>addsuffix<et>addsuffix<q>addsuffix<close>] +[join[, ]] }}}/>
{
	background-image: linear-gradient(<<colour primary>>, <<colour primary>>);
	background-size: 3px calc(100% - 24px);
	background-position: 0 12px;
	background-repeat: no-repeat;
}
<%endif%>
</$let>
